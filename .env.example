# Postgres connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Site URL (sitemap, OG image, canonical)
# Sunucunun GERÇEKTEN yayın yaptığı adresi yazın: Vercel'de www -> www'suz
# yönlendirme varsa buraya www'suz hâli gelmeli. Canonical'ın yönlendirilen bir
# adrese işaret etmesi Search Console'da "kopya sayfa" uyarısı üretir.
# Sonuna boşluk/satır sonu KAÇMASIN.
NEXT_PUBLIC_SITE_URL="https://osmancancetlenbik.com"

# Admin paneli için (production'da güçlü değerler kullan)
# ADMIN_PASSWORD_HASH oluşturmak için: npx tsx scripts/hash-password.ts
# ADMIN_PASSWORD (plain) yalnız geriye dönük uyumluluk içindir — production'da hash kullanın.
ADMIN_PASSWORD_HASH=""
JWT_SECRET="32-karakter-veya-daha-uzun-rastgele-string"

# Contact form için (https://resend.com'dan al)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="osman.cetlenbik@cbu.edu.tr"
